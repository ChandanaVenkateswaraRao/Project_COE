!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
*.lcov
.nyc_output

# Next.js & Turbopack
/.next/
/out/
.turbo/

# Production / Bundler outputs
/build
/dist

# Environment variables & secrets (prevent accidental credential leaks)
.env
.env*.local
.env.development
.env.test
.env.production
.env.staging
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.pfx
credentials.json
*service-account*.json
google-credentials*.json

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma Generated Client
/src/generated/prisma
/src/generated/

# Uploaded & Temporary files
/src/uploads/
uploads/
temp/
tmp/
.temp/
.tmp/
*.tmp

# Bloom AI & Local databases
bloom.json
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs
/logs/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# IDEs and Editors
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
